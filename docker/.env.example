# NOT USED ANYMORE. docker-compose.yml now hardcodes fixed credentials
# (admin / admin@123 for both InfluxDB and Grafana) so students don't need
# to create or edit an .env file at all. Kept here only as a reference for
# instructors who want to change the defaults for their own run — edit the
# literal values directly in docker-compose.yml instead of using this file.
#
# INFLUX_USERNAME=admin
# INFLUX_PASSWORD=admin@123
# INFLUX_ORG=mqtt-tutorial
# INFLUX_BUCKET=telemetry
# INFLUX_TOKEN=admin@123
#
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin@123
