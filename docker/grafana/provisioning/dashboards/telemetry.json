{
  "id": null,
  "uid": "telemetry-dashboard",
  "title": "MQTT Telemetry",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Temperature (°C)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb_main" },
      "fieldConfig": {
        "defaults": { "unit": "celsius" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb_main" },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => r._field == \"temperature\")",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Humidity (%)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb_main" },
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb_main" },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => r._field == \"humidity\")",
          "refId": "A"
        }
      ]
    }
  ]
}
